{
  "name": "nova-tech-cotizador",
  "version": "1.0.0",
  "author": "TeknoTech Services",
  "description": "TeknoTech Services - Sistema de Cotización para Equipo",
  "main": "dist/main/src/main/electron-main.js",
  "scripts": {
    "dev": "vite",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "build:exe": "npm run build && npx electron-builder --win nsis",
    "db:init": "tsx src/main/database.ts",
    "db:seed": "tsx database/seed.ts",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "lucide-react": "^0.441.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.5.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.16.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.teknotech.cotizador",
    "productName": "TeknoTech Services Cotizador",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      ".env",
      "package.json"
    ],
    "win": {
      "icon": "assets/logo-icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeknoTech Services Cotizador"
    }
  }
}
